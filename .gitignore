# Las dependencias y lo construido se hacen en cada maquina y en el CI: no
# van al repo. Lo que se publica es dist/, que arma el CI.
node_modules/
dist/

# Las variables de cada maquina (frontend/ y backend/) no van al repo: lo que
# hace falta saber esta en cada .env.example.
.env
.env.*
!.env.example

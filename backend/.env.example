# Variables del backend (Express + Prisma). Copia este archivo a backend/.env
# para tu maquina (npm run dev lo lee) o ponlas en Render (Environment).
# .env NO va al repo: lo ignora .gitignore. Aqui solo van nombres y ejemplos.

# Puerto. Render pone el suyo; en tu maquina, 3000.
PORT=3000

# --- La base de Supabase (PENDIENTE-ARIEL: Supabase -> Connect) -----------
# Copia las cadenas tal cual las da Supabase (Connect). Para el servidor: el
# pooler en modo transaccion (puerto 6543). Supabase pide SSL: si al conectar
# sale "self-signed certificate", ver PENDIENTES.md.
DATABASE_URL=postgresql://postgres.<proyecto>:<clave-de-la-base>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Para el CLI de Prisma (db pull, migrate diff): la conexion directa (5432).
DIRECT_URL=postgresql://postgres.<proyecto>:<clave-de-la-base>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---------------------------------------------------------
SUPABASE_URL=https://ugscqizansixnsuzljtu.supabase.co
# Solo si el proyecto firma los tokens con el secreto HS256 de antes
# (Supabase -> Project Settings -> JWT Keys). Con claves nuevas, vacio.
SUPABASE_JWT_SECRET=
# Secreta: guarda la direccion y la forma de pago en la cuenta de Auth.
# (PENDIENTE-ARIEL: Supabase -> Project Settings -> API Keys -> service_role)
SUPABASE_SERVICE_ROLE_KEY=

# --- Quien puede llamar desde el navegador (CORS) ---------------------------
# Separadas por comas; un * vale por un trozo de nombre. localhost siempre vale.
ORIGENES_PERMITIDOS=https://arielnoob24.github.io,https://el-tradicional-panaderia.netlify.app,https://*--el-tradicional-panaderia.netlify.app

{
  "name": "el-tradicional-api",
  "private": true,
  "version": "0.1.0",
  "description": "API REST de El Tradicional: Express + Prisma sobre la base de Supabase que ya existe.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "generar": "prisma generate",
    "probar": "node --test \"pruebas/*.test.mjs\"",
    "base-local": "node pruebas/baseLocal.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "jose": "6.2.18",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@electric-sql/pglite-socket": "0.3.0",
    "prisma": "7.10.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true
  },
  "overrides": {
    "effect": "3.22.5"
  }
}

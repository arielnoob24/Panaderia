# Variables del sitio (frontend). Copia este archivo a .env.local para
# cambiarlas en tu maquina, o ponlas en Netlify (Site configuration ->
# Environment variables). Todas son PUBLICAS: terminan en el navegador.
# Nada secreto va aqui (ni DATABASE_URL ni la service_role de Supabase).
# Si no pones ninguna, vite.config.js usa las del proyecto de hoy.

# La API. Hoy, la Edge Function de Supabase:
VITE_API_URL=https://ugscqizansixnsuzljtu.supabase.co/functions/v1/api
# Con el backend Express desplegado en Render, su direccion + /api, por ejemplo:
# VITE_API_URL=https://el-tradicional-api.onrender.com/api

# Supabase Auth (crear cuenta, entrar, recuperar la contrasena).
VITE_SUPABASE_URL=https://ugscqizansixnsuzljtu.supabase.co
VITE_SUPABASE_CLAVE_PUBLICA=sb_publishable_T4ayAx_e96H98bv_dlnCrg_AncGFwos

# Firebase Firestore (los avisos del local en Contactanos). La clave web es
# publica; lo que protege los datos son las reglas de firebase/firestore.rules.
# Sin estas dos, los avisos no salen y la pagina sigue igual.
VITE_FIREBASE_PROJECT_ID=el-tradicional-panaderia
VITE_FIREBASE_API_KEY=AIzaSyBS5cgMObB_2wA1J4ImnV2TZJPTYWzJuDQ
